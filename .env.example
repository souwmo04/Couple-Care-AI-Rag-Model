# CoupleCare AI configuration. Copy to .env and adjust. Contains no secrets.
# All values are optional; these are the defaults.

# Backend binds to loopback only. Non-loopback values are rejected at startup.
COUPLECARE_HOST=127.0.0.1
COUPLECARE_PORT=8000
COUPLECARE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Local llama.cpp server (must be a loopback address; remote inference is refused).
COUPLECARE_LLM_BASE_URL=http://127.0.0.1:18080
COUPLECARE_LLM_TIMEOUT_SECONDS=120
COUPLECARE_DEFAULT_MODEL_ID=qwen3-4b-instruct-2507

# Embeddings: multilingual E5 on CPU keeps the GPU free for generation.
# Use "hashing" only for offline testing (non-semantic).
COUPLECARE_EMBEDDING_BACKEND=sentence-transformers
COUPLECARE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
COUPLECARE_EMBEDDING_DEVICE=cpu
# Optional cross-encoder reranker (disabled when empty), e.g. a multilingual MiniLM cross-encoder.
# COUPLECARE_RERANKER_MODEL=

# Relevance calibration (see docs/retrieval-calibration.md). Re-calibrate on the dev split only.
COUPLECARE_DENSE_SCORE_FLOOR=0.75
COUPLECARE_DENSE_SCORE_CEILING=0.90
COUPLECARE_BM25_SATURATION=6.0

# Ingestion
COUPLECARE_CHUNK_SIZE_CHARS=900
COUPLECARE_CHUNK_OVERLAP_CHARS=150
COUPLECARE_MAX_INGEST_FILE_BYTES=5242880

# Privacy: message text is never logged unless this is explicitly true.
COUPLECARE_LOG_LEVEL=INFO
COUPLECARE_LOG_MESSAGE_CONTENT=false
COUPLECARE_STORE_EVAL_TRACES=false
